# A custom Java runtime containing only the modules this application uses.
#
# Because jlink produces binaries, the Linux flavour and Java version in both stages must
# match. Both are Alpine and Java 25.
#
# HOW THIS CHANGED, and why it is simpler now.
#
# This used to drive the beryx jlink Gradle plugin from a separate build-jlink.gradle,
# which meant putting the application on the MODULE path: a module-info.java, a merged
# module, and a build file selected with `--build-file`. Two things ended that. Gradle 9
# removed --build-file and -b, so the file could no longer be selected at all. And a modern
# Spring Boot application cannot produce a merged module without a fight - the attempt lists
# a dozen "Cannot find module exporting ..." errors for optional dependencies of logback and
# netty that are never used at runtime.
#
# jdeps and jlink do the same job with none of that. The application stays on the classpath,
# where Spring Boot expects it; jdeps reads the jar and reports which JDK modules it
# actually touches; jlink builds a runtime containing exactly those. Measured on Java 25:
# eleven modules, and a runtime of 87 MB against a full JDK of 384 MB.

## Stage 1 : build the jar, then a runtime sized to it
FROM eclipse-temurin:25-jdk-alpine AS jlinker

WORKDIR /stella
COPY . /stella

# binutils for objcopy, which jlink uses to strip debug symbols; unzip to look inside the jar.
RUN apk --no-cache add binutils unzip

RUN ./gradlew build

# Spring Boot's jar nests the application under BOOT-INF, so jdeps has to be pointed at the
# unpacked classes and told where the dependencies are. --ignore-missing-deps is expected
# here: the optional dependencies above are absent by design.
RUN unzip -q build/libs/stella-0.0.1-SNAPSHOT.jar -d /extracted && \
    MODULES=$(jdeps --ignore-missing-deps --print-module-deps --multi-release 25 \
        --class-path '/extracted/BOOT-INF/lib/*' \
        --recursive /extracted/BOOT-INF/classes) && \
    echo "jlink modules: $MODULES" && \
    jlink --add-modules "$MODULES" \
        --strip-debug --no-header-files --no-man-pages \
        --output /jre


## Stage 2 : the runtime and the application, and nothing else
FROM alpine:3.22

COPY --from=jlinker /jre /jre
COPY --from=jlinker /stella/build/libs/stella-0.0.1-SNAPSHOT.jar /app/stella.jar

CMD ["/jre/bin/java", "-jar", "/app/stella.jar"]
